rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPost(data) {
      return data.keys().hasAll(['userName', 'country', 'city', 'title', 'story', 'category', 'isApproved']) &&
             data.userName is string && data.userName.size() <= 100 &&
             data.country is string && data.country.size() <= 80 &&
             data.city is string && data.city.size() <= 100 &&
             data.title is string && data.title.size() <= 200 &&
             data.story is string && data.story.size() <= 10000 &&
             data.category is string && data.category.size() <= 50 &&
             data.isApproved is bool;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['userName', 'text']) &&
             data.userName is string && data.userName.size() <= 100 &&
             data.text is string && data.text.size() <= 1500;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Community Posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isValidId(postId) && isValidPost(request.resource.data);
      allow update: if isValidId(postId) && (
        // Community liking or viewing updates
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'viewsCount']) ||
        // Admin moderation updates
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isApproved']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isFeatured']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isApproved', 'isFeatured'])
      );
      allow delete: if isValidId(postId);

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isValidId(commentId) && isValidComment(request.resource.data);
        allow delete: if isValidId(commentId);
      }
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isValidId(announcementId);
    }

    // Site Analytics
    match /analytics/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }
  }
}
