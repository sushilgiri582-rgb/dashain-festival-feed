rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Community Posts - Shared Global Feed
    match /posts/{postId} {
      allow read: if true;
      allow create: if isValidId(postId);
      allow update: if isValidId(postId);
      allow delete: if isValidId(postId);

      // Comments & blessings subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if isValidId(commentId);
      }
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isValidId(announcementId);
    }

    // Site Analytics & Counters
    match /analytics/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }
  }
}
